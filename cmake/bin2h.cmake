# Auto-generates a C++ header embedding one or more binary files as byte
# arrays, invoked via `cmake -P bin2h.cmake -DINPUT_FILES=... -DOUTPUT_FILE=...`.
#
# INPUT_FILES: a list of absolute paths joined with '|' (not ';', since ';'
#              would already have been split by CMake's -D argument parsing
#              before this script ever sees it).
# OUTPUT_FILE: absolute path of the header to write.

if(NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "bin2h.cmake requires -DOUTPUT_FILE=...")
endif()

if(DEFINED INPUT_FILES AND NOT INPUT_FILES STREQUAL "")
    string(REPLACE "|" ";" INPUT_FILE_LIST "${INPUT_FILES}")
else()
    set(INPUT_FILE_LIST "")
endif()

set(header_content
"// Auto-generated by bin2h.cmake -- DO NOT EDIT
#pragma once
#include <cstddef>

struct EmbeddedSound { const unsigned char* data; std::size_t size; };

")

set(array_declarations "")
set(table_entries "")
set(index 0)

foreach(wav_path ${INPUT_FILE_LIST})
    file(READ "${wav_path}" hex_content HEX)
    string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1," array_body "${hex_content}")

    string(APPEND array_declarations
        "inline const unsigned char g_sound_${index}[] = {\n${array_body}\n};\n\n")
    string(APPEND table_entries
        "    { g_sound_${index}, sizeof(g_sound_${index}) },\n")

    math(EXPR index "${index} + 1")
endforeach()

if(index EQUAL 0)
    # A C++ array cannot have zero elements; keep a harmless placeholder entry
    # while g_embedded_sounds_count stays 0 so it is never actually indexed.
    set(table_entries "    { nullptr, 0 },\n")
endif()

string(APPEND header_content "${array_declarations}")
string(APPEND header_content "inline const EmbeddedSound g_embedded_sounds[] = {\n${table_entries}};\n")
string(APPEND header_content "inline constexpr std::size_t g_embedded_sounds_count = ${index};\n")

file(WRITE "${OUTPUT_FILE}" "${header_content}")
